# Production build-time env vars for the Vite frontend.
# Vite inlines these at build time, so they must be set wherever `npm run build` runs
# (Docker build args / CI, not just the running container).

VITE_API_URL=https://thrift-ease.onrender.com/api
VITE_APP_NAME=ThriftEase
VITE_APP_VERSION=1.0.0
