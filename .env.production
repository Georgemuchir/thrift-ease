# Production build-time env vars for the Vite frontend.
# Vite inlines these at build time, so they must be set wherever `npm run build` runs
# (Docker build args / CI, not just the running container).

# TODO: replace with the real deployed backend URL (see backend/.env.production ALLOWED_ORIGINS,
# which must include the frontend origin this file's build gets deployed to).
VITE_API_URL=https://REPLACE-WITH-BACKEND-DOMAIN/api
VITE_APP_NAME=ThriftEase
VITE_APP_VERSION=1.0.0
