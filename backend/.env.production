# Production environment template.
# On Render these are set via render.yaml / the dashboard, not this file —
# this exists as documentation of what MUST be configured in production.

ENVIRONMENT=production
DEBUG=False

# Set by Render from the thriftease-db database (see render.yaml)
DATABASE_URL=postgresql://user:password@host:5432/thriftease

# Generated by Render (render.yaml: generateValue: true)
SECRET_KEY=

ALLOWED_ORIGINS=["https://stunning-baklava-4ecf05.netlify.app"]
